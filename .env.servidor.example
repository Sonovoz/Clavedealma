# Plantilla para un servidor PHP 8.3 + MariaDB (+ Redis) detrás de un proxy con SSL
# (p. ej. Nginx Proxy Manager), como el VPS de OVH con contenedores php-web, mariadb y redis.
# NO hace falta copiarla a mano: el instalador web (/instalar) crea el .env a partir de ella
# la primera vez que se abre la web, con una APP_KEY nueva, y rellena la base de datos y el
# administrador con lo que se escribe en el asistente. Guía: docs/instalacion-servidor.md

APP_NAME="Clave de Alma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clavedealma.es
APP_DOMAIN=clavedealma.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Detrás del proxy con SSL: se confía en él para saber que es HTTPS y la IP real.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Base de datos: la escribe el instalador (servidor «mariadb» si es el contenedor de MariaDB).
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Caché y sesiones: «database», o «redis» si el instalador encuentra Redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Sin proceso de colas aparte: los emails salen al momento.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: todo por SMTP. Los datos se escriben en el panel (Ajustes → Correo).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="pedidos@clavedealma.es"
MAIL_FROM_NAME="${APP_NAME}"

# Pagos: Redsys en pruebas. Los datos del TPV se escriben en el panel (Ajustes → Pagos).
PAYMENT_DRIVER=redsys
REDSYS_ENVIRONMENT=test

# Google: false mientras sea de pruebas; true al lanzar.
SEO_INDEXING=false

# Copias en el servidor. Para copias fuera (Object Storage), BACKUP_OFFSITE=true y AWS_*.
BACKUP_DISK=backups
BACKUP_OFFSITE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=gra
AWS_ENDPOINT=https://s3.gra.io.cloud.ovh.net
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

ERROR_ALERTS=true
ERROR_ALERT_EMAIL=
TWO_FACTOR_REQUIRED=true

# Tareas programadas lanzadas desde fuera: https://<dominio>/cron/<CRON_TOKEN> cada minuto.
# Lo genera el instalador.
CRON_TOKEN=

VITE_APP_NAME="${APP_NAME}"
