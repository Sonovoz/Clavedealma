# Plantilla para PRODUCCIÓN / STAGING en OVH con Docker Compose.
# Copiar como .env junto a docker-compose.yml. Ver docs/despliegue-docker.md

APP_NAME="Clave de Alma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clavedealma.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=clavedealma
DB_USERNAME=clavedealma
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pedidos@clavedealma.es"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Dominio raíz. Las tiendas viven en APP_DOMAIN/<clave> (ADR 0013);
# <clave>.APP_DOMAIN y /tienda/<clave> redirigen ahí.
APP_DOMAIN=clavedealma.es

# Superadministrador inicial (lo crea `php artisan db:seed`)
SUPERADMIN_NAME="Superadmin"
SUPERADMIN_EMAIL=admin@clavedealma.es
SUPERADMIN_PASSWORD=

APP_VERSION=latest

# Pagos (docs/compra). Stripe: claves reales solo en producción; webhook: https://<dominio>/webhooks/stripe
PAYMENT_DRIVER=stripe
ORDERS_ALERT_EMAIL=
# Dirección a la que el cliente envía las devoluciones (va en las instrucciones)
RETURNS_ADDRESS=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Búsqueda
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Certificado comodín (Traefik + API de OVH)
ACME_EMAIL=
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

VITE_APP_NAME="${APP_NAME}"

# Tamaño máximo de cada fichero subido al panel (MB): fotos y diseños de producción
UPLOAD_MAX_MB=20


# Copias de seguridad: s3 guarda fuera del servidor (Object Storage de OVH, credenciales AWS_*)
BACKUP_DISK=s3

# Asistente de IA del panel (config/ai.php). none = desactivado; openai = API con formato OpenAI (OpenAI u otros)
AI_DRIVER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Nombre exacto del modelo que indique vuestro proveedor
AI_MODEL=

# Veri*Factu (docs/facturacion.md): none = registros en local sin enviar; aeat = con certificado.
VERIFACTU_DRIVER=none
# true solo en producción (QR de la sede de la AEAT)
VERIFACTU_PRODUCTION=false
