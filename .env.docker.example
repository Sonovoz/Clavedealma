# Plantilla para el VPS de OVH con Docker Compose (docs/despliegue-docker.md).
# Copiar como .env junto a docker-compose.yml y rellenar lo que está vacío.
# Viene preparada para la FASE DE PRUEBAS: Redsys sin cobrar y sin indexar en Google.
# Para lanzar: REDSYS_ENVIRONMENT=live (o «Pasar a cobros reales» en el panel) y SEO_INDEXING=true.
# Las contraseñas y claves solo aquí, en el servidor: nunca en GitHub ni en el chat.

APP_NAME="Clave de Alma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clavedealma.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Detrás de Traefik (HTTPS): se confía en él para saber la IP real y que es HTTPS.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=clavedealma
DB_USERNAME=clavedealma
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo de salida. Con el correo de OVH (Email Pro / MX Plan): ssl0.ovh.net, 465, smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=pedidos@clavedealma.es
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="pedidos@clavedealma.es"
MAIL_FROM_NAME="${APP_NAME}"

# Object Storage de OVH (compatible con S3), para las copias fuera del servidor.
# Panel de OVH → Public Cloud → Object Storage: crea un usuario S3 y un contenedor privado.
# Región y dirección según donde lo crees (p. ej. gra → https://s3.gra.io.cloud.ovh.net).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=gra
AWS_ENDPOINT=https://s3.gra.io.cloud.ovh.net
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true


# Dominio raíz. Las tiendas viven en APP_DOMAIN/<clave> (ADR 0013);
# <clave>.APP_DOMAIN y /tienda/<clave> redirigen ahí.
APP_DOMAIN=clavedealma.es

# Superadministrador inicial (lo crea `php artisan db:seed`)
SUPERADMIN_NAME="Superadmin"
SUPERADMIN_EMAIL=admin@clavedealma.es
SUPERADMIN_PASSWORD=

APP_VERSION=latest

# Pagos (docs/compra, ADR 0026): Redsys, el TPV virtual del banco. Los datos los da el banco.
# URL de notificación para el banco: https://<dominio>/webhooks/redsys
# REDSYS_ENVIRONMENT=test no cobra nada; live solo cuando se venda de verdad.
# (PAYMENT_DRIVER=fake permite probar sin TPV; nunca en producción)
PAYMENT_DRIVER=redsys
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=test
REDSYS_BIZUM=false
ORDERS_ALERT_EMAIL=
# Dirección a la que el cliente envía las devoluciones (va en las instrucciones)
RETURNS_ADDRESS=
# Stripe (apagado; solo si se vuelve a PAYMENT_DRIVER=stripe)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Búsqueda (Meilisearch): aún no se usa; el servicio solo arranca con --profile busqueda.
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Certificado comodín (Traefik + API de OVH)
ACME_EMAIL=
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

VITE_APP_NAME="${APP_NAME}"

# Tamaño máximo de cada fichero subido al panel (MB): fotos y diseños de producción
UPLOAD_MAX_MB=20


# Copias de seguridad: en el servidor (volumen «storage») y, además, fuera, en el Object
# Storage de OVH (credenciales AWS_*). Contenedor propio para las copias, o el de AWS_BUCKET.
BACKUP_DISK=backups
BACKUP_OFFSITE=true
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_FOLDER=copias

# Avisos por email de los errores de la web (vacío = SUPERADMIN_EMAIL). Como mucho 10 a la hora.
ERROR_ALERTS=true
ERROR_ALERT_EMAIL=

# Verificación en dos pasos obligatoria para el equipo del panel (ADR 0028).
TWO_FACTOR_REQUIRED=true

# Google: false mientras sea el servidor de pruebas; true solo al lanzar.
SEO_INDEXING=false

# Asistente de IA del panel (config/ai.php). none = desactivado; openai = API con formato OpenAI (OpenAI u otros)
AI_DRIVER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Nombre exacto del modelo que indique vuestro proveedor
AI_MODEL=

# Veri*Factu (docs/facturacion.md): desactivado hasta que Hacienda lo haga obligatorio.
VERIFACTU_ENABLED=false
# none = registros en local sin enviar; aeat = con certificado
VERIFACTU_DRIVER=none
# true solo en producción (QR de la sede de la AEAT)
VERIFACTU_PRODUCTION=false

# Días que se conserva el registro de seguridad (guarda IPs: RGPD)
SECURITY_LOG_DAYS=365
