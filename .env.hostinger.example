# Plantilla para las PRUEBAS en Hostinger (hosting PHP compartido).
# Copiar como .env en el servidor y rellenar. Ver docs/instalacion-hostinger.md
# Caché, sesiones y colas usan la base de datos; las colas se procesan por cron.

APP_NAME="Clave de Alma"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://pruebas.clavedealma.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Base de datos creada en el panel de Hostinger
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pedidos@clavedealma.es"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Dominio raíz. Las tiendas viven en APP_DOMAIN/<clave> (ADR 0013);
# <clave>.APP_DOMAIN y /tienda/<clave> redirigen ahí.
APP_DOMAIN=clavedealma.es

# Superadministrador inicial (lo crea `php artisan db:seed`)
SUPERADMIN_NAME="Superadmin"
SUPERADMIN_EMAIL=admin@clavedealma.es
SUPERADMIN_PASSWORD=

# Pagos (docs/compra, ADR 0026): Redsys, el TPV virtual del banco. Los datos los da el banco.
# URL de notificación para el banco: https://<dominio>/webhooks/redsys
# REDSYS_ENVIRONMENT=test no cobra nada; live solo cuando se venda de verdad.
# (PAYMENT_DRIVER=fake permite probar sin TPV; nunca en producción)
PAYMENT_DRIVER=redsys
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_ENVIRONMENT=test
REDSYS_BIZUM=false
ORDERS_ALERT_EMAIL=
# Dirección a la que el cliente envía las devoluciones (va en las instrucciones)
RETURNS_ADDRESS=
# Stripe (apagado; solo si se vuelve a PAYMENT_DRIVER=stripe)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Tamaño máximo de cada fichero subido al panel (MB): fotos y diseños de producción
UPLOAD_MAX_MB=20


# Copias de seguridad: disco donde se guardan (backups = en el servidor, s3 = Object Storage)
BACKUP_DISK=backups

# Servidor de pruebas: que Google no lo indexe
SEO_INDEXING=false

# Asistente de IA del panel (config/ai.php). none = desactivado; openai = API con formato OpenAI (OpenAI u otros)
AI_DRIVER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Nombre exacto del modelo que indique vuestro proveedor
AI_MODEL=

# Veri*Factu (docs/facturacion.md): desactivado hasta que Hacienda lo haga obligatorio.
VERIFACTU_ENABLED=false
# none = registros en local sin enviar; aeat = con certificado
VERIFACTU_DRIVER=none
# true solo en producción (QR de la sede de la AEAT)
VERIFACTU_PRODUCTION=false

# Días que se conserva el registro de seguridad (guarda IPs: RGPD)
SECURITY_LOG_DAYS=365

# Avisos por email de los errores de la web (vacío = SUPERADMIN_EMAIL).
ERROR_ALERTS=true
ERROR_ALERT_EMAIL=

# Verificación en dos pasos obligatoria para el equipo del panel (ADR 0028).
TWO_FACTOR_REQUIRED=true
